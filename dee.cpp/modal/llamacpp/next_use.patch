+// logits with a MoE cache that holds every expert, and with each eviction policy at the small cache size, must equal logits_ref bit for bit
+// returns the name of the first variant that differs, nullptr if all match
+template <typename DC>
+static const char * check_moe_cache_invariance(
+        struct gguf_context * gguf_ctx, const size_t seed, const float stdev, const DC & dc,
+        const llama_model_tensor_buft_override * overrides, const std::vector<llama_token> & tokens, const std::vector<float> & logits_ref) {
+    struct variant {
+        const char * name;
+        const char * policy;
+        size_t       size;
+    };
+    const variant variants[] = {
+        { "cache size", nullptr,    (size_t) 256*1024*1024 },
+        { "next_use",   "next_use", dc.moe_cache_size      },
+    };
+    for (const variant & v : variants) {
+        set_moe_cache_policy(v.policy);
+        std::vector<float> logits;
+        {
+            auto mc = get_model_and_ctx(gguf_ctx, nullptr, seed, stdev, dc.devs, dc.split_mode, false, overrides, v.size);
+            logits = get_logits(mc.first.get(), mc.second.get(), tokens);
+        }
+        set_moe_cache_policy(nullptr);
+        if (logits.size() != logits_ref.size() || memcmp(logits.data(), logits_ref.data(), logits.size()*sizeof(float)) != 0) {
+            return v.name;
+        }
+    }
+    return nullptr;
+}
